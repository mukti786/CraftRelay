# ── CraftRelay backend — environment variables example ─────
# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://craftrelay:changeme@localhost:5432/craftrelay
DATABASE_SYNC_URL=postgresql+psycopg2://craftrelay:changeme@localhost:5432/craftrelay

# ── Security ──────────────────────────────────────────────
SECRET_KEY=replace-with-a-random-256-bit-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS — allowed origins for local development ──────────
CORS_ORIGINS=http://localhost:8081,http://192.168.1.100:8081

# ── File storage ──────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760   # 10 MB

# ── AI provider (optional — Part 8) ─────────────────────
# AI_PROVIDER=google
# GOOGLE_API_KEY=your-key-here

# ── Environment ───────────────────────────────────────────
ENVIRONMENT=development
