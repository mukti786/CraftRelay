APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./craftrelay.db
# Local development placeholder only. Set a high-entropy secret in the host secret manager for production.
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173
# Local filesystem path for development; production requires an absolute operator-verified persistent mount.
EVIDENCE_DIR=./data/evidence
MAX_UPLOAD_BYTES=20971520
ACCESS_TOKEN_MINUTES=60
COOKIE_SAMESITE=lax
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=CraftRelay Administrator
AI_ASSISTANCE_PROVIDER=none
