# ────────────────────────────────────────────────────────────
#  CraftRelay — root .gitignore
# ────────────────────────────────────────────────────────────

# ── Secrets / environment ─────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# ── Node / npm ────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# ── Expo / React Native ───────────────────────────────────
.expo/
dist/
web-build/
android/
ios/
*.orig.*

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.venv/
venv/
ENV/
env/
.Python
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Alembic generated env (keep versions) ─────────────────
backend/alembic.ini.bak

# ── Uploads / local file storage ─────────────────────────
backend/uploads/
backend/media/

# ── IDEs ──────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── OS ────────────────────────────────────────────────────
Desktop.ini
$RECYCLE.BIN/
