# Internal project documentation is kept locally and excluded from the public repository.
/docs/

# Local environment secrets (keep checked-in templates).
.env
.env.*
!.env.example
!**/.env.example

# Local databases and database sidecars.
*.db
*.sqlite
*.sqlite3

# Private evidence and user uploads.
**/data/evidence/
**/private_uploads/
**/uploads/private/

# Python environments, caches, and generated bytecode.
.venv/
**/.venv/
**/.tmp/
**/.uv-cache/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Frontend dependencies and generated output.
/frontend/node_modules/
/frontend/dist/
/frontend/.tmp/
/frontend/.vite/
*.tsbuildinfo

# Local tooling and operating-system files.
.uv-cache/
.DS_Store
